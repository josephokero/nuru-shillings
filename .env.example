# Copy to .env and fill in. Never commit real values.

# Public site URL (no trailing slash)
APP_URL=http://localhost:8765

# Postgres (Neon)
DATABASE_URL=

# Encryption key: 32 random bytes, base64
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NSH_ENC_KEY=

# Transactional email (Resend)
RESEND_API_KEY=
NURU_MAIL_FROM=
NURU_SUPPORT_TO=

# Identity checks (Didit)
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=

# Admin console owner (email of the single admin account)
NSH_ADMIN_EMAIL=

# PayPal (optional for local wallet top-ups)
NSH_PAYPAL_CLIENT_ID=
NSH_PAYPAL_CLIENT_SECRET=
NSH_PAYPAL_WEBHOOK_ID=
NSH_PAYPAL_MODE=sandbox

# M-Pesa via PayHero (optional)
NSH_PAYHERO_USERNAME=
NSH_PAYHERO_PASSWORD=
NSH_PAYHERO_CHANNEL_ID=
NSH_PAYHERO_CALLBACK_URL=

# Bunny.net private storage for avatars (optional)
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_KEY=
BUNNY_STORAGE_HOST=
